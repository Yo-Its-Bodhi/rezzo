# Public URL guests can open from their phones. Use the deployed HTTPS URL in production.
APP_URL=http://192.168.2.99:3000
DATABASE_URL=postgres://rezzo:change-me@127.0.0.1:5432/rezzo
DATABASE_SSL=disable

# Staff access. Generate the hash with: npm run auth:hash -- "your passcode"
SESSION_SECRET=replace-with-at-least-32-random-characters
STAFF_PASSCODE_HASH=

# QR waitlist. Set false to hide guest pages and the staff tab.
NEXT_PUBLIC_WAITLIST_ENABLED=true

# Browser push: generate once with web-push.generateVAPIDKeys(); keep the private key secret.
# Retain these keys across deployments so existing guest subscriptions remain valid.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://rezzo.bodhix.io

# Twilio SMS fallback for waitlist updates when browser push is unavailable.
# Use either the classic Auth Token flow or the newer API Key + Secret flow.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM=La Chingada <reservations@your-verified-domain.com>
